    {
      "id": "sub-cs501",
      "code": "CS501",
      "name": "Design & Analysis of Algorithms",
      "department": "Computer Science",
      "degree": "B.Tech",
      "branch": "Computer Science & Engineering",
      "semester": 5,
      "credits": 4,
      "syllabusOverview": "Divide and conquer, greedy strategies, dynamic programming, network flow, NP-completeness.",
      "units": [
        {
          "unitNumber": 1,
          "title": "Asymptotic Complexity & Recurrences",
          "topics": [
            "Big O/Omega/Theta",
            "Master Theorem",
            "Divide & Conquer"
          ]
        },
        {
          "unitNumber": 2,
          "title": "Greedy Algorithms",
          "topics": [
            "Huffman Coding",
            "Fractional Knapsack",
            "Kruskal & Prim MST"
          ]
        },
        {
          "unitNumber": 3,
          "title": "Dynamic Programming",
          "topics": [
            "0/1 Knapsack",
            "Matrix Chain Multiplication",
            "Longest Common Subsequence"
          ]
        },
        {
          "unitNumber": 4,
          "title": "Graph Algorithms",
          "topics": [
            "Bellman-Ford",
            "Floyd-Warshall",
            "Max Flow Min Cut"
          ]
        },
        {
          "unitNumber": 5,
          "title": "Tractable & Intractable Problems",
          "topics": [
            "P vs NP",
            "NP-Hard reductions",
            "Traveling Salesperson"
          ]
        }
      ],
      "textbooks": [
        "Introduction to Algorithms (CLRS)",
        "Algorithm Design by Kleinberg & Tardos"
      ],
      "createdAt": "2024-01-01T00:00:00Z"
    },
    {
      "id": "sub-cs502",
      "code": "CS502",
      "name": "Database Management Systems",
      "department": "Computer Science",
      "degree": "B.Tech",
      "branch": "Computer Science & Engineering",
      "semester": 5,
      "credits": 4,
      "syllabusOverview": "Relational data model, SQL/DDL, normal forms (1NF-BCNF), transaction ACID, indexing, recovery.",
      "units": [
        {
          "unitNumber": 1,
          "title": "Relational Algebra & ER Modeling",
          "topics": [
            "Entity-Relationship diagrams",
            "Relational constraints",
            "SQL Queries"
          ]
        },
        {
          "unitNumber": 2,
          "title": "Database Design & Normalization",
          "topics": [
            "Functional dependencies",
            "1NF, 2NF, 3NF, BCNF",
            "Lossless decomposition"
          ]
        },
        {
          "unitNumber": 3,
          "title": "Transaction Processing",
          "topics": [
            "ACID properties",
            "Schedules & Serializability",
            "Two-phase locking"
          ]
        },
        {
          "unitNumber": 4,
          "title": "Storage & Indexing",
          "topics": [
            "B+ Trees",
            "Hashing",
            "Query Execution Plans"
          ]
        },
        {
          "unitNumber": 5,
          "title": "Crash Recovery",
          "topics": [
            "WAL logging",
            "ARIES algorithm",
            "Checkpointing"
          ]
        }
      ],
      "textbooks": [
        "Database System Concepts by Silberschatz, Korth, Sudarshan"
      ],
      "createdAt": "2024-01-01T00:00:00Z"
    },
